# Copie este arquivo para .env e preencha com suas chaves de verdade.
# NUNCA comite o .env real — o .gitignore já bloqueia isso.

# --- Groq (obrigatório — usado nas etapas 1, 2 e 3) ---------------------- #
# Pegue grátis em https://console.groq.com/keys
GROQ_API_KEY=cole_sua_chave_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# --- Geração de imagem (etapa 3) ----------------------------------------- #
# Pollinations.ai é o provedor padrão e não exige chave — a de baixo é
# opcional, só melhora o rate limit. Crie grátis em https://enter.pollinations.ai
POLLINATIONS_API_KEY=

# Only needed if you run gerador_imagem.py com --provedor together
# Crie conta grátis em https://api.together.ai e gere a chave em
# https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# Caminho pra uma fonte .ttf específica pro texto sobre a imagem (opcional
# — se vazio, o script tenta achar uma fonte padrão do sistema sozinho)
FONTE_TITULO=

# --- WordPress (obrigatório — usado na etapa 4) -------------------------- #
# Gere uma Senha de Aplicativo em wp-admin -> Usuários -> Perfil -> Senhas
# de Aplicativo (nativo do WordPress 5.6+, não precisa de plugin)
WP_URL=https://seublog.com.br
WP_USUARIO=cole_seu_usuario_aqui
WP_APP_PASSWORD=cole_sua_senha_de_aplicativo_aqui

# draft (padrão, recomendado) | publish | pending | private | future
WP_STATUS=draft
